#version 460

layout (local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, set = 0, binding = 0) writeonly uniform image2D targetImage;

layout(set = 0, binding = 1) uniform CameraData {
    mat4 inv_view;     
    mat4 inv_proj;     
    vec4 camera_pos; 
};

struct HitResult {
    vec3 position;      
    vec3 normal;        
    ivec3 voxel;        
    vec2 uv;
    int face;
    float distance;     
    bool hit;
};

const float FLT_MAX = 3.4028235e+38;

bool is_solid(ivec3 pos) {
    if (pos.y == 0) {
        return true;
    }
    
    return false;
}

HitResult trace_dda(vec3 origin, vec3 direction, float max_distance, uint max_steps) {
    HitResult result;
    result.hit = false;
    result.distance = max_distance;
    
    ivec3 current_voxel = ivec3(floor(origin - 1e-6));
    
    ivec3 step = ivec3(sign(direction));
    
    vec3 t_max;
    vec3 delta_t;
    
    for (int i = 0; i < 3; i++) {
        float dir = direction[i];
        float pos = origin[i];
        
        if (dir == 0.0) {
            t_max[i] = 1e30;
            delta_t[i] = 1e30;
        } else {
            delta_t[i] = abs(1.0 / dir);
            
            if (step[i] > 0) {
                t_max[i] = (float(current_voxel[i]) + 1.0 - pos) / dir;
            } else {
                t_max[i] = (float(current_voxel[i]) - pos) / dir;
            }
            
            if (t_max[i] < 0.0) t_max[i] = 0.0;
        }
    }
    
    float t_current = 0.0;
    int last_axis = 0;

    for (int step_count = 0; step_count < max_steps; step_count++) {
        if (is_solid(current_voxel)) {
            result.hit = true;
            result.voxel = current_voxel;

            result.distance = t_current;
            
            result.position = origin + direction * result.distance;
            vec3 hit_local = result.position - vec3(current_voxel);
            
            result.normal = vec3(0.0);
            if (last_axis == 0) {
                result.face = (step.x > 0) ? 0 : 1;  // Right or left
                result.uv = vec2(hit_local.z, hit_local.y);
                result.normal = vec3(-float(step.x), 0.0, 0.0);
            } else if (last_axis == 1) {
                result.face = (step.y > 0) ? 2 : 3;  // Top or bottom
                result.uv = vec2(hit_local.x, hit_local.z);
                result.normal = vec3(0.0, -float(step.y), 0.0);
            } else {
                result.face = (step.z > 0) ? 4 : 5;  // Front or back
                result.uv = vec2(hit_local.x, hit_local.y);
                result.normal = vec3(0.0, 0.0, -float(step.z));
            }
            
            break;
        }
        
        // Step to next voxel
        if (t_max.x < t_max.y) {
            if (t_max.x < t_max.z) {
                t_current = t_max.x;
                last_axis = 0;
                current_voxel.x += step.x;
                t_max.x += delta_t.x;
            } else {
                t_current = t_max.z;
                last_axis = 2;
                current_voxel.z += step.z;
                t_max.z += delta_t.z;
            }
        } else {
            if (t_max.y < t_max.z) {
                t_current = t_max.y;
                last_axis = 1;
                current_voxel.y += step.y;
                t_max.y += delta_t.y;
            } else {
                t_current = t_max.z;
                last_axis = 2;
                current_voxel.z += step.z;
                t_max.z += delta_t.z;
            }
        }
    }
    
    return result;
}

void main() 
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 imageSize = imageSize(targetImage);

    if (any(greaterThanEqual(pixelCoord, imageSize)))
        return;


    vec2 uv = vec2(pixelCoord) / vec2(imageSize);
    vec4 ndc = vec4(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0, 1.0, 1.0);
    
    vec4 view_ray = inv_proj * ndc;
    view_ray = vec4(normalize(view_ray.xyz), 0.0);
    
    vec4 world_ray = inv_view * view_ray;
    vec3 ray_dir = normalize(world_ray.xyz);
    vec3 ray_origin = camera_pos.xyz;

    HitResult hit = trace_dda(ray_origin, ray_dir, 10000, 500);

    vec4 color;
    float depth;
    float near_plane = 0.1;
    float far_plane = 1000.0;
    if (hit.hit) {
        color = vec4(hit.uv, 0.0, 1.0);
    } else {
        color = vec4(
            0.0,
            0.0,
            0.0,
            1.0
        );
    }
    imageStore(targetImage, pixelCoord, color);
}